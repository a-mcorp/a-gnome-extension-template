# Deno
#   `deno.lock` pins dependency versions and should be committed.
#   `vendor/` is created by `"vendor": true` in `deno.jsonc`; commit it only for fully offline builds.
# deno.lock
vendor/
#   Project-local Deno environment (binary, cache and tools).
denoenv-*/

# Node.js compatibility
#   Deno creates `node_modules/` when `npm:` packages need it, or when `"nodeModulesDir"` is set.
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Distribution / packaging
build/
dist/
out/

# Unit test / coverage reports
#   Created by `deno test --coverage` and `deno coverage --lcov`.
coverage/
cov_profile/
*.lcov
.nyc_output/

# Logs
logs/
*.log

# Caches
.cache/
.eslintcache

# Environments
#   Commit an `.env.example` without secrets instead.
.env
.env.*
!.env.example
.envrc

# Visual Studio Code
#   Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore
#   that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#   and can be added to the global gitignore or merged into this file. However, if you prefer,
#   you could uncomment the following to ignore the entire vscode folder
# .vscode/

# JetBrains
#   JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#   be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
# .idea/

# GNOME Shell extension
#   Transpiled extension, created by `deno task build` into `dist/`.
#   Packed extension, created by `deno task pack`.
*.shell-extension.zip
#   Compiled settings schemas and translations, created on installation.
gschemas.compiled
*.mo
